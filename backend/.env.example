# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# LiveKit SIP — outbound calling via Twilio (optional)
# LIVEKIT_SIP_URI is your project's inbound SIP URI (Settings → SIP).
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID is produced by scripts/setup_outbound_trunk.py
# once the TWILIO_* credentials below are filled in — see backend/README.md
# "Outbound calling" section.
# -----------------------------------------------------------------------------
LIVEKIT_SIP_URI=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Optional: a number the agent can transfer an escalated caller to.
HUMAN_TRANSFER_NUMBER=

# -----------------------------------------------------------------------------
# Twilio — SIP trunk that LiveKit routes outbound calls through
# Elastic SIP Trunking → your trunk → Termination / Credential List
# -----------------------------------------------------------------------------
TWILIO_SIP_TERM_URI=your-trunk.pstn.twilio.com
TWILIO_SIP_USERNAME=your_sip_credential_username
TWILIO_SIP_PASSWORD=your_sip_credential_password
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Human escalation (optional) — see backend/README.md "Human escalation"
# Every escalation is always saved locally (data/agent.db, viewable via
# scripts/escalation_dashboard.py) regardless of this. Set this to also POST
# each one to a Slack Incoming Webhook, a Discord webhook (append /slack to
# its URL), or any other JSON endpoint.
# -----------------------------------------------------------------------------
ESCALATION_WEBHOOK_URL=
